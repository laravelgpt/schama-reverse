{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "SchemaForge workspace project",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique project identifier" },
        "name": { "type": "string", "description": "Project display name" },
        "description": { "type": "string", "description": "Project description" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "name", "userId"]
    },
    "Import": {
      "title": "Import",
      "description": "Schema import operation details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Import operation ID" },
        "projectId": { "type": "string", "description": "Associated project ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "sourceType": { "type": "string", "description": "Source format like sql, json, zip" },
        "databaseEngine": { "type": "string", "description": "Detected engine: mysql, pgsql, sqlite, etc." },
        "status": { "type": "string", "description": "Status of import process" },
        "fileCount": { "type": "number", "description": "Number of files imported" },
        "tableCount": { "type": "number", "description": "Number of tables parsed" },
        "warningCount": { "type": "number", "description": "Count of analysis warnings" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Import timestamp" }
      },
      "required": ["id", "projectId", "userId", "status"]
    },
    "SchemaData": {
      "title": "SchemaData",
      "description": "Canonical database schema representation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Schema ID" },
        "projectId": { "type": "string", "description": "Associated project ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "schemaVersion": { "type": "string", "description": "Schema format version" },
        "summary": { "type": "string", "description": "Brief schema summary" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "projectId", "userId"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "User database engineering projects"
    },
    "/projects/{projectId}/imports/{importId}": {
      "schema": "Import",
      "description": "Imports associated with a project"
    },
    "/projects/{projectId}/schemas/{schemaId}": {
      "schema": "SchemaData",
      "description": "Parsed canonical schemas for a project"
    }
  }
}
